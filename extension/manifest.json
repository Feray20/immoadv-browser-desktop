{
  "manifest_version": 3,
  "name": "ImmoAdv Browser",
  "short_name": "ImmoAdv",
  "version": "2.0.0",
  "description": "ImmoAdv-Schicht für Chrome: Startseite, Datenschutz-Center, Werbe-, Tracker-, Malware- und Phishing-Schutz.",
  "minimum_chrome_version": "121",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "ImmoAdv Datenschutz-Center",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "options_page": "panel.html?full=1",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "privacy",
    "storage",
    "sidePanel",
    "contentSettings",
    "bookmarks",
    "topSites",
    "contextMenus",
    "tabs",
    "webNavigation",
    "alarms",
    "browsingData",
    "management",
    "favicon",
    "history",
    "downloads",
    "proxy",
    "webRequest",
    "webRequestAuthProvider"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "werbung",
        "enabled": true,
        "path": "rules/werbung.json"
      },
      {
        "id": "malware",
        "enabled": true,
        "path": "rules/malware.json"
      },
      {
        "id": "phishing",
        "enabled": true,
        "path": "rules/phishing.json"
      }
    ]
  },
  "web_accessible_resources": [
    {
      "resources": [
        "blocked.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  }
}
